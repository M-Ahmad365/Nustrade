NODE_ENV=production
PORT=4000

# Railway Postgres — use DATABASE_URL (Railway injects this automatically)
DATABASE_URL=your-railway-postgres-connection-string

# Fallback individual vars (used if DATABASE_URL is not set)
PG_HOST=your-railway-postgres-host
PG_PORT=5432
PG_DB=railway
PG_USER=postgres
PG_PASSWORD=your-railway-postgres-password

# MongoDB Atlas
MONGO_URI=mongodb+srv://<user>:<password>@cluster0.xxxxx.mongodb.net/nustrade?retryWrites=true&w=majority

# Railway Redis — use REDIS_URL (Railway injects this automatically)
REDIS_URL=redis://default:<password>@your-railway-redis-host:6379

JWT_SECRET=change-this-to-a-long-random-string-minimum-32-characters
JWT_EXPIRY=7d

BCRYPT_ROUNDS=12

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=muhammadahmad098654@gmail.com
SMTP_PASSWORD=your-gmail-app-password
SMTP_FROM="NusTrade <muhammadahmad098654@gmail.com>"

# Comma-separated list of allowed frontend origins
CORS_ORIGIN=https://nustrade.vercel.app
