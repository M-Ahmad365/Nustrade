        {
          "name": "Dispute Transaction",
          "request": {
            "method": "POST",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": "{{base}}/transactions/{{txId}}/dispute"
          }
        }
      ]
    },
    {
      "name": "Chat",
      "item": [
        {
          "name": "Start Chat",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const d = pm.response.json();",
                  "if (d.success) pm.collectionVariables.set('threadId', d.data.thread.thread_id);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "url": "{{base}}/chat/start",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"listing_id\": 1,\n  \"seller_id\": 2\n}"
            }
          }
        },
        {
          "name": "My Threads",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": "{{base}}/chat/threads"
          }
        },
        {
          "name": "Get Thread",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": "{{base}}/chat/threads/{{threadId}}"
          }
        },
        {
          "name": "Poll Messages (since timestamp)",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": {
              "raw": "{{base}}/chat/threads/{{threadId}}/messages?since=2025-01-01T00:00:00.000Z",
              "query": [{ "key": "since", "value": "2025-01-01T00:00:00.000Z" }]
            }
          }
        },
        {
          "name": "Send Message",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "url": "{{base}}/chat/threads/{{threadId}}/messages",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"content\": \"Is the book still available? Can you hold it until tomorrow?\"\n}"
            }
          }
        },
        {
          "name": "Mark Thread as Read",
          "request": {
            "method": "POST",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": "{{base}}/chat/threads/{{threadId}}/read"
          }
        }
      ]
    },
    {
      "name": "Reviews",
      "item": [
        {
          "name": "Create Review",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const d = pm.response.json();",
                  "if (d.success) pm.collectionVariables.set('reviewId', d.data.review.review_id);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "url": "{{base}}/reviews",
